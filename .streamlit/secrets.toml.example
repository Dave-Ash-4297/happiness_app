# Snowflake Configuration
# Copy this file to .streamlit/secrets.toml and fill in your Snowflake credentials

snowflake_user = "your_snowflake_username"
snowflake_password = "your_snowflake_password"
snowflake_account = "xy12345.us-east-1"  # Find this in your Snowflake URL
snowflake_warehouse = "COMPUTE_WH"        # Or your warehouse name
snowflake_database = "HAPPINESS_DB"       # Created by snowflake_setup.sql
snowflake_schema = "PUBLIC"               # Or your schema name

# Optional: Email Configuration (if you want to add email reminders)
# email_sender = "your-email@company.com"
# email_password = "your-app-password"
